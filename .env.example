# Required — Postgres connection string (Vercel Postgres, Neon, Supabase,
# or any Postgres with the pgvector extension available). The app creates
# its own schema on first connection; no manual migration needed.
DATABASE_URL=

# Enables the semantic-search fallback tier in policy matching (embeddings
# via OpenAI's text-embedding-3-small), plus AI-assisted document
# extraction. Optional — without it, matching still works via exact and
# full-text/keyword search, and documents can still be entered by hand.
#
# Copy this file to .env.local and fill in your values. .env.local is
# gitignored and never committed.
OPENAI_API_KEY=
